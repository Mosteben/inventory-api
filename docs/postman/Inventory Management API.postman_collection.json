          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();\r",
                  "\r",
                  "if (data.token) {\r",
                  "\r",
                  "    pm.environment.set(\"TOKEN\", data.token);\r",
                  "\r",
                  "}\r",
                  "\r",
                  "if (data.user) {\r",
                  "\r",
                  "    pm.environment.set(\"USER_ID\", data.user.id);\r",
                  "\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
